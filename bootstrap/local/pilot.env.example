# Copy to pilot.env (gitignored) and adjust. Never put secrets here.
#   cp pilot.env.example pilot.env

# --- Cluster ---
CLUSTER_NAME=solo-dev

# --- Argo CD Git source (required; no file://) ---
# Option A — remote Git (HTTPS, no production credentials; public/read-only):
# ARGOCD_REPO_URL=https://github.com/bookchaowalit/solo-empire.git
# ARGOCD_TARGET_REVISION=main
#
# Option B — local disposable git HTTP snapshot (default for uncommitted pilot work):
#   ./start-local-git-source.sh writes ARGOCD_REPO_URL for you.
ARGOCD_REPO_URL=
ARGOCD_TARGET_REVISION=HEAD

# --- Local container registry (k3d disposable) ---
# Host push endpoint and in-cluster pull endpoint are set by create-registry.sh
REGISTRY_NAME=solo-registry
REGISTRY_HOST_PORT=5111
# Filled by create-registry.sh / deploy-pilot.sh when empty:
# REGISTRY_PUSH_HOST=localhost:5111
# REGISTRY_PULL_HOST=k3d-solo-registry:5000

# --- Image ---
IMAGE_NAME=solo-empire/ai-doc-assistant
# Tag defaults to git-<fullsha> when IMAGE_TAG is empty
IMAGE_TAG=

# --- Optional OpenAI (never commit the real value) ---
# Create the Secret with create-pilot-secret.sh instead of putting the key here.
# OPENAI_API_KEY is read only from the environment of create-pilot-secret.sh
ENABLE_EXTERNAL_SECRET=false

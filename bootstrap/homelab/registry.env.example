# Copy to a machine-local path only (never commit real credentials).
# Example: /etc/solo-empire-registry/registry.env on Fedora (mode 0600)

# LAN bind identity
REGISTRY_HOST=registry.homelab.local
REGISTRY_IP=192.168.152.12
REGISTRY_PORT=5000
REGISTRY_BIND=${REGISTRY_IP}:${REGISTRY_PORT}

# Persistent paths on Fedora
REGISTRY_DATA_DIR=/var/lib/solo-empire-registry
REGISTRY_CONF_DIR=/etc/solo-empire-registry
REGISTRY_CERT_DIR=/etc/solo-empire-registry/certs
REGISTRY_AUTH_DIR=/etc/solo-empire-registry/auth

# Immutable registry image (not :latest)
REGISTRY_IMAGE=public.ecr.aws/docker/library/registry:2.8.3

# Basic auth username (password generated out-of-band into htpasswd; never in Git)
REGISTRY_USER=solo-registry

# Container name
REGISTRY_CONTAINER=solo-empire-registry

# Copy to backend.hcl (gitignored). Never commit real keys or endpoints with secrets.
# Credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY from secret manager.

bucket       = "solo-empire-tfstate-staging"
key          = "bootstrap/fsn1/terraform.tfstate"
region       = "fsn1"
endpoint     = "https://fsn1.your-objectstorage.com"
encrypt      = true
use_lockfile = true

skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
use_path_style              = true

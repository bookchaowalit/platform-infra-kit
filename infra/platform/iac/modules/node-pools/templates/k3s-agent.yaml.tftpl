#cloud-config
package_update: true
packages:
  - curl
  - ca-certificates
write_files:
  - path: /usr/local/share/ca-certificates/solo-registry-ca.crt
    permissions: "0644"
    encoding: b64
    content: ${registry_ca_b64}
  - path: /etc/rancher/k3s/registry-ca.crt
    permissions: "0644"
    encoding: b64
    content: ${registry_ca_b64}
  - path: /etc/rancher/k3s/registries.yaml
    permissions: "0600"
    content: |
      mirrors:
        "${registry_hostname}:5000":
          endpoint:
            - "https://${registry_private_ip}:5000"
        "${registry_private_ip}:5000":
          endpoint:
            - "https://${registry_private_ip}:5000"
      configs:
        "${registry_hostname}:5000":
          auth:
            username: ${registry_username}
            password: ${registry_password}
          tls:
            ca_file: /etc/rancher/k3s/registry-ca.crt
        "${registry_private_ip}:5000":
          auth:
            username: ${registry_username}
            password: ${registry_password}
          tls:
            ca_file: /etc/rancher/k3s/registry-ca.crt
runcmd:
  - update-ca-certificates || true
  - |
    set -euo pipefail
    curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" K3S_URL="${server_url}" K3S_TOKEN="${k3s_token}" sh -s - agent \
      --node-name "${node_name}" \
      --node-label "${node_label}"
  - systemctl restart k3s-agent || true
final_message: "k3s agent ready; registry TLS trust installed for ${registry_hostname}"

{
  "version": 1,
  "purpose": "read-only multi-PaaS control-plane catalog",
  "deployment_enabled": false,
  "write_actions_enabled": false,
  "write_actions_reason": "Provider mutations remain disabled until an explicit provider, resource, and approval workflow is defined.",
  "providers": [
